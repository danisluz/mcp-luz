# Copie para .env e preencha localmente. Nunca versione o arquivo .env.
CONTEXT7_API_KEY=
FIGMA_API_KEY=
# PostgreSQL (habilita o MCP postgres quando todas forem preenchidas)
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=
# SonarQube: token + SONARQUBE_ORG (Cloud) ou SONARQUBE_URL (Server).
SONARQUBE_TOKEN=
SONARQUBE_ORG=
SONARQUBE_URL=
# Use este override se o cliente iniciar o Hub fora da pasta do projeto.
MCP_PROJECT_NAME=
# Use este override se o Nexus não estiver em <PROJECTS_ROOT>/nexus.
NEXUS_ROOT=
